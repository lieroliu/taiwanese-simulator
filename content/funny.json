 "events": [
  {"id":"flour_undies","y":[1961,1969],"minAge":3,"maxAge":10,"weight":1.2,"cat":"生活","tone":"neutral","text":"媽媽用美援的麵粉袋幫我縫了一件內褲。屁股上印著「中美合作」四個字，洗了好幾次都洗不掉。"},
  {"id":"tv_neighbor","y":[1962,1975],"minAge":5,"maxAge":14,"weight":1,"cat":"生活","tone":"good","text":"巷子裡只有雜貨店有電視。晚上我跟著一群人擠在店門口看布袋戲，看到史艷文出場，大家一起叫好。回家才發現拖鞋只剩一隻。"},
  {"id":"hair_ban","y":[1961,1987],"minAge":12,"maxAge":18,"need":["student"],"weight":1,"cat":"生活","tone":"bad","text":"教官拿尺量我的頭髮，說超過耳上一公分，當場拿剪刀剪了一刀。我頂著那顆像被狗啃過的頭，上了一個禮拜的課。"},
  {"id":"pinworm","y":[1961,2023],"minAge":6,"maxAge":10,"weight":1,"cat":"健康","tone":"neutral","text":"學校發了蟯蟲檢查的貼紙。我早上忘了貼，到學校才躲進廁所補貼，交出去的時候心虛得不敢看老師。"},
  {"id":"handkerchief","y":[1961,1995],"minAge":7,"maxAge":12,"weight":1,"cat":"生活","tone":"neutral","text":"衛生股長要檢查手帕和衛生紙，我忘了帶。隔壁同學也沒帶，我們輪流拿他口袋裡那一條給股長看。"},
  {"id":"popcorn_rice","y":[1961,1992],"minAge":4,"maxAge":12,"weight":1,"cat":"生活","tone":"good","text":"我拿了一碗家裡的米去巷口換爆米香。阿伯大喊一聲「要爆囉」，我摀著耳朵還是被嚇到跳起來，米香撒了一地。"},
  {"id":"redenvelope","minAge":5,"maxAge":12,"months":[1,2],"weight":1.4,"cat":"家庭","tone":"neutral","text":"過年收到的紅包，媽媽說要「先幫我存起來」。我後來再也沒見過那些錢。"},
  {"id":"medicine_show","y":[1961,1985],"minAge":5,"maxAge":14,"need":["rural"],"weight":0.9,"cat":"生活","tone":"neutral","text":"廟口來了一團賣藥的，先表演胸口碎大石，再開始賣藥膏。{elders}買了兩罐，說可以治百病，後來都拿來擦蚊子咬的包。"},
  {"id":"marbles","y":[1961,1990],"minAge":6,"maxAge":12,"weight":1,"cat":"生活","tone":"bad","text":"我贏了一整個鐵盒的尪仔標，藏在床底下。媽媽打掃的時候以為是垃圾，全部丟掉了。我哭了一個下午。"},
  {"id":"military_jinma","y":[1961,2008],"minAge":19,"maxAge":22,"sex":"M","weight":0.8,"cat":"人生","tone":"neutral","text":"我抽到外島。{elders}聽到「金馬獎」，以為我得了什麼獎，還跑去跟鄰居炫耀。"},
  {"id":"military_quilt","y":[1961,2018],"minAge":19,"maxAge":22,"sex":"M","weight":0.9,"cat":"人生","tone":"bad","text":"新訓的時候，我的棉被沒摺成豆腐干，被班長從二樓窗戶丟下去。我在操場撿棉被，全連都在看。"},
  {"id":"rooster_head","y":[1961,1995],"minAge":18,"maxAge":60,"need":["working"],"months":[1,2],"weight":0.8,"cat":"人生","tone":"bad","text":"尾牙那桌的雞頭剛好朝著我。我整頓飯都吃不下，一直在想自己哪裡做錯。過完年，老闆什麼也沒說。"},
  {"id":"raffle","y":[1980,2060],"minAge":20,"maxAge":64,"need":["working"],"months":[1,2],"weight":1,"cat":"人生","tone":"neutral","text":"尾牙抽獎，我抽到一串衛生紙。老闆的姪子抽到一台機車，台下拍手拍得很用力。"},
  {"id":"tour_hk","y":[1979,1995],"minAge":20,"maxAge":65,"weight":0.7,"cat":"生活","tone":"good","text":"我第一次出國，跟團去香港。同團的阿姨把飯店的拖鞋、小肥皂和牙刷全部收進行李箱，還問我要不要她的份。"},
  {"id":"cable_cut","y":[1984,1993],"minAge":5,"maxAge":70,"weight":1,"cat":"生活","tone":"neutral","text":"爸爸在頂樓偷接了第四台。聽說有人要來剪線那天，全家把電視關掉，燈也關掉，假裝沒有人在家。"},
  {"id":"video_rewind","y":[1983,2005],"minAge":10,"maxAge":50,"weight":0.9,"cat":"生活","tone":"neutral","text":"我租的錄影帶忘了倒帶就拿去還，被老闆多收了五塊。他用很失望的眼神看著我，好像我做了什麼壞事。"},
  {"id":"space_invaders","y":[1980,1992],"minAge":9,"maxAge":16,"weight":0.9,"cat":"生活","tone":"neutral","text":"我拿買參考書的錢去打電動，打到一半被訓導主任從後面拎住衣領。那台機器上的小蜜蜂還在飛。"},
  {"id":"brick_phone","y":[1989,1995],"minAge":15,"maxAge":70,"weight":0.8,"cat":"生活","tone":"neutral","text":"餐廳裡有個叔叔拿著大哥大講電話，講得很大聲，整間餐廳都在看他。他好像很滿意。"},
  {"id":"bbcall","y":[1991,2001],"minAge":14,"maxAge":35,"weight":1.2,"cat":"生活","tone":"neutral","text":"半夜 BB.Call 響了，螢幕上是「0748」。我翻了半天的密碼表，才知道是「你去死吧」。我想了一整晚是誰。"},
  {"id":"tiger_poster","y":[1988,1993],"minAge":8,"maxAge":18,"weight":0.8,"cat":"生活","tone":"neutral","text":"我把小虎隊的海報貼在床頭，隔天被姊姊撕下來，換成她自己喜歡的。我們冷戰了三天。"},
  {"id":"slam_dunk","y":[1992,1998],"minAge":8,"maxAge":20,"weight":1,"cat":"生活","tone":"good","text":"為了看《灌籃高手》新的一集，我放學就衝去租書店，在門口等到老闆拉開鐵門。"},
  {"id":"mrt_muzha","y":[1996,1998],"minAge":5,"maxAge":80,"county":["台北市","台北縣"],"weight":0.8,"cat":"生活","tone":"good","text":"我第一次坐木柵線。車頭沒有司機，我站在最前面盯著軌道看了一路，坐過站兩次。"},
  {"id":"egg_tart","y":[1997,1998],"minAge":10,"maxAge":70,"urban":true,"weight":1.2,"cat":"生活","tone":"neutral","text":"我排了兩個小時買葡式蛋塔，輪到我的時候剛好剩最後一盒。三個月後，那間店就收了。"},
  {"id":"tamagotchi","y":[1997,1999],"minAge":7,"maxAge":15,"need":["student"],"weight":1,"cat":"生活","tone":"bad","text":"我上課偷玩電子雞，被老師沒收。放學拿回來的時候，牠已經餓死了，螢幕上只剩一個墓碑。"},
  {"id":"y2k","y":[1999,1999],"months":[12],"minAge":20,"maxAge":60,"need":["working"],"weight":2,"cat":"人生","tone":"neutral","text":"公司要我跨年夜留守機房，說千禧蟲可能會讓電腦全部當機。結果什麼事都沒發生，我跟同事吃了一整晚的鹹酥雞。"},
  {"id":"constructivist","y":[1996,2003],"minAge":7,"maxAge":10,"need":["student"],"weight":0.8,"cat":"生活","tone":"neutral","text":"我用建構式數學算 8 加 7，畫了一整頁的圈圈。爸爸在旁邊看了很久，說他看不懂，叫我直接背九九乘法。"},
  {"id":"lineage","y":[2000,2008],"minAge":13,"maxAge":28,"weight":1,"cat":"生活","tone":"neutral","text":"我在網咖打了一整晚的《天堂》。早上走出網咖，天已經亮了，媽媽就站在門口。"},
  {"id":"meteor_garden","y":[2001,2002],"minAge":8,"maxAge":30,"weight":0.9,"cat":"生活","tone":"neutral","text":"我妹每天看《流星花園》，在家學道明寺講話，對我說「你很閒喔」。我真的很閒，只好陪她看。"},
  {"id":"sms_newyear","y":[2001,2010],"months":[1],"minAge":12,"maxAge":60,"weight":0.9,"cat":"生活","tone":"neutral","text":"跨年那晚，我傳給大家的新年快樂簡訊，隔天中午才送到。有人回我：「也祝你中午快樂。」"},
  {"id":"sars_temp","y":[2003,2003],"months":[4,5,6],"minAge":12,"maxAge":70,"weight":1.5,"cat":"健康","tone":"neutral","text":"進大樓要量額溫。我量了三次都是 34 度，警衛看著我，說要不要先去看醫生。"},
  {"id":"msn_nick","y":[2003,2012],"minAge":13,"maxAge":30,"weight":1,"cat":"生活","tone":"neutral","text":"我把 MSN 的暱稱改成一句歌詞，等某個人發現。等了一個禮拜，只有我媽問我是不是心情不好。"},
  {"id":"wretch","y":[2005,2012],"minAge":13,"maxAge":28,"weight":1,"cat":"生活","tone":"neutral","text":"我在無名小站換了三次相簿封面。大頭貼是 45 度角往上拍的，眼睛放大了一圈，我自己都快認不出來。"},
  {"id":"kitty_magnet","y":[2005,2005],"minAge":8,"maxAge":50,"weight":1.2,"cat":"生活","tone":"neutral","text":"為了集滿便利商店的 Hello Kitty 磁鐵，我那個月多買了二十幾瓶飲料，冰箱塞滿了喝不完的綠茶。"},
  {"id":"voucher","y":[2009,2009],"months":[1,2,3],"minAge":10,"maxAge":90,"weight":1.5,"cat":"生活","tone":"good","text":"我領到三千六百塊的消費券。在家裡跟大家討論了三天要買什麼，最後拿去換了一台電鍋。"},
  {"id":"plasticizer","y":[2011,2011],"months":[5,6,7],"minAge":10,"maxAge":80,"weight":1.4,"cat":"健康","tone":"bad","text":"我喝完最後一口運動飲料，才看到新聞說那個牌子驗出塑化劑。我盯著空瓶子看了很久。"},
  {"id":"doomsday","y":[2012,2012],"months":[12],"minAge":12,"maxAge":70,"weight":1.5,"cat":"生活","tone":"neutral","text":"同事在群組裡倒數馬雅世界末日。隔天早上，大家照樣在九點前打卡。"},
  {"id":"duck_pop","y":[2013,2014],"months":[12,1],"minAge":5,"maxAge":80,"county":["基隆市"],"weight":1.5,"cat":"生活","tone":"neutral","text":"跨年夜，港邊的黃色小鴨突然爆掉了。我站在人群裡，看著它慢慢扁下去，旁邊的小孩哭了。"},
  {"id":"oil_scandal","y":[2014,2015],"minAge":15,"maxAge":80,"weight":1.2,"cat":"健康","tone":"bad","text":"我常吃的那家鍋貼店，門口貼了一張紙：「本店用油與新聞無關」。我站在門口想了一下，還是點了十顆。"},
  {"id":"elder_pics","y":[2014,2060],"minAge":15,"maxAge":50,"need":["parentsAlive"],"weight":1.4,"cat":"家庭","tone":"neutral","text":"媽媽每天早上七點，在家族群組傳一張荷花寫「早安，平安喜樂」。我已讀，沒有回。"},
  {"id":"elder_pics_me","y":[2014,2090],"minAge":58,"weight":1.4,"cat":"家庭","tone":"neutral","text":"我每天早上在家族群組傳一張早安圖。孩子都已讀不回，我照傳，至少知道他們還活著。","need":["kids"]},
  {"id":"pokemon","y":[2016,2017],"minAge":10,"maxAge":65,"weight":1.2,"cat":"生活","tone":"good","text":"新聞說半夜公園擠滿了抓寶的人。我在自己家巷口抓到一隻臭臭泥，開心到睡不著。"},
  {"id":"tp_panic","y":[2018,2018],"months":[2,3],"minAge":10,"maxAge":85,"weight":1.6,"cat":"家庭","tone":"neutral","text":"聽說衛生紙要漲價，家裡的人去量販店扛了六大串回來，客廳堆到半個人高。我們用到第二年都還沒用完。"},
  {"id":"claw","y":[2017,2020],"minAge":12,"maxAge":45,"weight":1,"cat":"生活","tone":"neutral","text":"我在夾娃娃機投了三百塊，夾到一隻顏色怪怪的皮卡丘。我抱著它坐公車回家，覺得很丟臉，也很開心。"},
  {"id":"bubble_tea_line","y":[2018,2019],"minAge":12,"maxAge":50,"urban":true,"weight":1,"cat":"生活","tone":"neutral","text":"我排了四十分鐘買黑糖珍珠鮮奶，拍了照才喝。拍得比喝得還久。"},
  {"id":"mask_line","y":[2020,2020],"months":[2,3,4],"minAge":15,"maxAge":90,"weight":1.6,"cat":"健康","tone":"neutral","text":"我拿著健保卡去藥局排隊買口罩。前面的阿伯跟藥師聊了十分鐘他孫子的事，後面沒有一個人催他。"},
  {"id":"salmon","y":[2021,2021],"months":[3],"minAge":16,"maxAge":40,"weight":1.6,"cat":"生活","tone":"neutral","text":"同事為了吃免費的壽司，跑去戶政事務所把名字改成「鮭魚之夢」。一個禮拜後，他又請假去改回來。"},
  {"id":"egg_shortage","y":[2023,2023],"months":[1,2,3],"minAge":15,"maxAge":90,"weight":1.4,"cat":"家庭","tone":"neutral","text":"超市的雞蛋一直缺貨。我跑了三間才買到一盒，捧回家的樣子，好像捧著什麼寶貝。"},
  {"id":"ai_letter","y":[2023,2045],"minAge":16,"maxAge":40,"weight":1,"cat":"生活","tone":"neutral","text":"我請 AI 幫我寫一封告白訊息。對方回得很快，回得很工整，看起來也是 AI 寫的。"},
  {"id":"karaoke_bus","y":[1980,2030],"minAge":40,"maxAge":85,"weight":1,"cat":"生活","tone":"good","text":"我跟進香團坐遊覽車去拜媽祖。車上的卡拉 OK 從上車唱到下車，香還沒拜到，嗓子先啞了。"},
  {"id":"health_talk","y":[1995,2060],"minAge":60,"weight":1.2,"cat":"生活","tone":"bad","text":"我去聽了一場免費的健康講座，拿到一盒雞蛋。回家的時候，手上多了一罐三萬塊的保健食品。"},
  {"id":"glasses_head","minAge":50,"weight":1,"cat":"生活","tone":"neutral","text":"我找了老花眼鏡十分鐘，翻遍了整個家。家裡的人走過來，指了指我的頭頂。"},
  {"id":"remote_fridge","minAge":75,"weight":0.8,"cat":"生活","tone":"neutral","text":"我找不到電視遙控器，後來在冰箱裡找到了，跟一盒豆腐放在一起。我笑了很久，沒有跟孩子說。"},
  {"id":"bbq_alley","y":[1987,2060],"months":[9,10],"minAge":5,"maxAge":80,"weight":1.2,"cat":"生活","tone":"good","text":"中秋節，整條巷子的人都在騎樓烤肉，煙大到隔壁的鄰居以為失火。我身上的烤肉味，三天都洗不掉。"},
  {"id":"campaign_truck","y":[1989,2060],"months":[11,12,1],"minAge":8,"maxAge":90,"weight":0.8,"cat":"生活","tone":"neutral","text":"一大早，選舉宣傳車就在巷口放「凍蒜！凍蒜！」。我被吵醒，翻了個身，用棉被蓋住頭。"},
  {"id":"electric_float","y":[1980,2005],"minAge":8,"maxAge":70,"need":["rural"],"weight":0.8,"cat":"生活","tone":"neutral","text":"隔壁辦喪事，請了電子花車。台上的人跳得比辦喜事還熱鬧，全村的小孩都擠在最前面看。"},
  {"id":"gout_duck","y":[1990,2060],"months":[11,12,1],"minAge":35,"maxAge":75,"sex":"M","weight":0.8,"cat":"健康","tone":"bad","text":"我跟朋友吃了一鍋薑母鴨，又喝了幾瓶啤酒。半夜腳痛到用爬的去廁所，醫生說是痛風。"},
  {"id":"wedding_host","y":[1980,2010],"minAge":18,"maxAge":70,"need":["rural"],"weight":0.8,"cat":"生活","tone":"neutral","text":"我去喝喜酒，台上的主持人一直講黃色笑話，新娘的阿嬤笑得最大聲。"},
  {"id":"wedding_takeaway","y":[1970,2060],"minAge":10,"maxAge":85,"weight":1,"cat":"生活","tone":"neutral","text":"喜宴還沒結束，同桌的阿姨已經拿出塑膠袋，開始打包剩下的菜。她也幫我包了一袋。"},
  {"id":"quake_sleep","minAge":10,"maxAge":80,"region":"東","weight":1,"cat":"生活","tone":"neutral","text":"半夜搖了一下地震，外地來的同學嚇得衝到門口。我翻個身，繼續睡。"},
  {"id":"penghu_wind","minAge":6,"maxAge":80,"county":["澎湖縣"],"months":[10,11,12,1,2],"weight":1.2,"cat":"生活","tone":"neutral","text":"東北季風一來，我剛晾好的衣服就被吹到隔壁家的屋頂上。鄰居拿竹竿幫我挑下來，順便問我吃飽沒。"},
  {"id":"south_heat","minAge":18,"maxAge":80,"region":"南","months":[6,7,8],"weight":0.8,"cat":"生活","tone":"neutral","text":"中午出門買便當，機車的坐墊燙到不能坐。我站著騎了一整條街。"},
  {"id":"harvest_fest","minAge":5,"maxAge":70,"eth":"原住民","months":[7,8],"weight":1,"cat":"生活","tone":"good","text":"豐年祭跳到半夜，我被拉進圈圈裡，跳錯了好幾次腳步，旁邊的阿姨一直笑我。"},
  {"id":"hakka_tea","minAge":5,"maxAge":60,"eth":"客家","weight":0.7,"cat":"家庭","tone":"neutral","text":"{elders}一定要我把擂茶的芝麻磨到出油才能停。我磨到手痠，偷偷換手，還是被發現了。"},
  {"id":"newimm_food","y":[1998,2060],"minAge":6,"maxAge":15,"eth":"新住民子女","weight":0.8,"cat":"家庭","tone":"neutral","text":"媽媽幫我帶了她家鄉的菜當便當。同學聞到味道圍過來，有人說臭，有人吃了一口又跟我要第二口。"},
  {"id":"fortune","minAge":16,"maxAge":80,"weight":0.7,"cat":"生活","tone":"neutral","text":"我去{temple}抽了一支籤，是下下籤。我把籤放回去，又抽了一支，這次是上上籤。我決定相信第二支。"},
  {"id":"nightmarket_goldfish","minAge":5,"maxAge":14,"weight":0.8,"cat":"生活","tone":"good","text":"我在{nm}撈到兩隻金魚，裝在塑膠袋裡提回家。媽媽說養不活，結果牠們活得比我的成績還久。"},
  {"id":"scooter_family","y":[1965,1995],"minAge":3,"maxAge":10,"weight":1,"cat":"家庭","tone":"neutral","text":"我們一家四口擠在一台機車上去{elders}家。我站在最前面的踏板，弟弟夾在中間，媽媽手上還抱著一箱水果。"},
  {"id":"exam_god","minAge":14,"maxAge":19,"need":["student"],"weight":0.9,"cat":"生活","tone":"neutral","text":"考前，媽媽帶我去拜文昌帝君，供桌上放了一把蔥、一顆菜頭和一包粽子。我拜得很認真，回家還是沒有念書。"},
  {"id":"phone_cut","y":[1975,1998],"minAge":13,"maxAge":25,"weight":0.9,"cat":"家庭","tone":"bad","text":"我躲在客廳講電話講了一個小時。爸爸走過來，什麼也沒說，直接把電話線拔掉。"},
  {"id":"internet_dialup","y":[1996,2003],"minAge":10,"maxAge":30,"weight":0.9,"cat":"生活","tone":"neutral","text":"我用撥接上網，數據機一直發出嘰嘰嘎嘎的聲音。媽媽一拿起電話，網路就斷了，我在房間大叫。"},
  {"id":"lunch_steam","y":[1970,2010],"minAge":7,"maxAge":15,"need":["student"],"weight":0.9,"cat":"生活","tone":"neutral","text":"我把便當放進學校的蒸飯箱，中午拿出來，整個便當都是別人家的滷蛋味。"},
  {"id":"paolida","y":[1961,1990],"minAge":5,"maxAge":12,"weight":0.7,"cat":"家庭","tone":"neutral","text":"我偷喝了爸爸的保力達，以為是果汁。喝完臉紅了一個下午，被{elders}罵了一頓，又被偷偷笑了很久。"},
  {"id":"wfh_pants","y":[2020,2060],"minAge":22,"maxAge":60,"need":["working"],"weight":1,"cat":"人生","tone":"neutral","text":"在家開視訊會議，我上半身穿襯衫，下半身穿著睡褲。站起來拿水的時候，忘了鏡頭還開著。"},
  {"id":"delivery_neighbor","y":[2018,2060],"minAge":18,"maxAge":60,"urban":true,"weight":0.8,"cat":"生活","tone":"neutral","text":"下雨天我叫了外送。開門才發現，外送員就是住在我樓下的鄰居。我們互相點頭，都有點尷尬。"},
  {"id":"karaoke_boss","y":[1990,2030],"minAge":22,"maxAge":60,"need":["working"],"weight":0.9,"cat":"人生","tone":"neutral","text":"公司聚餐去唱 KTV，主管點了〈愛拚才會贏〉，大家都要站起來跟著拍手。我拍到手很痛，臉上還要笑。"},
  {"id":"grandkid_phone","y":[2012,2090],"by":[1940,1966],"minAge":65,"weight":1,"cat":"家庭","tone":"neutral","text":"孫子教我用手機視訊。我把手機拿得太近，對方只看得到我的鼻孔，講了十分鐘才發現。","need":["kids"]}
