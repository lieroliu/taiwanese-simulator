{
 "_format": "Pop-culture timeline: cartoons, TV, music, films, games, snacks, toys, tech and fads, by the years they were everywhere in Taiwan. One item = one thing a cohort remembers; each item has 1+ diary lines for different ages. y = [from,to] calendar years when it was common (not just its launch). minAge/maxAge on the item = who ran into it; a line's own minAge/maxAge/need/sex narrows further. skew multiplies weight: urban/rural, or an ethnicity name. name = short label for the end screen. src = how the year was checked. See content/FORMAT.md › popculture.json.",
 "items": [
  {"id": "shi_yanwen", "cat": "電視", "name": "史艷文布袋戲", "y": [1970, 1974], "minAge": 4, "maxAge": 70, "weight": 1.6, "src": "台視首播1970-03，1974-06停播", "lines": [{"maxAge": 14, "tone": "good", "text": "中午放學我用跑的回家，就為了趕上史艷文出場。藏鏡人一講話，我跟弟弟一起躲到椅子後面。"}, {"minAge": 18, "need": ["working"], "tone": "neutral", "text": "中午十二點半，工廠裡的人全擠到辦公室那台電視前面看布袋戲。領班自己也在看，沒人敢叫大家回去。"}, {"minAge": 15, "maxAge": 17, "tone": "neutral", "text": "布袋戲被停播了。班上男生還在學藏鏡人講話，「順我者生，逆我者亡」。"}]},
  {"id": "tv_bw", "cat": "電視", "name": "黑白電視", "y": [1962, 1975], "minAge": 3, "maxAge": 60, "weight": 1, "skew": {"rural": 1.3}, "src": "台視1962開播；彩色電視普及約1970年代中後", "lines": [{"maxAge": 12, "tone": "neutral", "text": "家裡終於買了電視，有木頭拉門，還要上鎖。爸爸看完新聞才會把門關起來，鑰匙放在他口袋。"}, {"minAge": 20, "tone": "good", "text": "我們分期付款買了一台電視。左鄰右舍晚上都來我家看，媽媽每天要多泡一壺茶。"}]},
  {"id": "qiong_yao", "cat": "電影", "name": "瓊瑤電影", "y": [1965, 1983], "minAge": 14, "maxAge": 35, "weight": 1.2, "skew": {"urban": 1.2}, "src": "窗外1973、彩雲飛1973、一簾幽夢1975等", "lines": [{"sex": "F", "tone": "good", "text": "我跟同學翹了半天課去看瓊瑤的電影，看到哭花了臉，出來還要假裝是沙子跑進眼睛。"}, {"sex": "M", "tone": "neutral", "text": "為了約隔壁班的女生，我陪她去看瓊瑤的電影。整場我都在偷看她，劇情一點都沒記住。"}, {"minAge": 25, "tone": "neutral", "text": "枕頭邊放著一本瓊瑤小說，是跟租書店借的，已經逾期三天了。"}]},
  {"id": "teresa_teng", "cat": "音樂", "name": "鄧麗君", "y": [1969, 1995], "minAge": 10, "maxAge": 80, "weight": 1.2, "src": "1969起走紅，1995過世", "lines": [{"maxAge": 25, "tone": "good", "text": "收音機在放鄧麗君，媽媽一邊洗衣服一邊跟著哼，哼到一半忘詞就用「啦啦啦」帶過。"}, {"minAge": 26, "tone": "neutral", "text": "騎車經過唱片行，門口的喇叭在放〈月亮代表我的心〉。我在紅燈前停了一下，覺得今天沒那麼累。"}]},
  {"id": "candy_cartoon", "cat": "卡通", "name": "小甜甜", "y": [1979, 1981], "minAge": 5, "maxAge": 13, "weight": 1, "src": "華視1979播出", "lines": [{"sex": "F", "tone": "good", "text": "我在作業簿背面畫小甜甜，畫了三十個，每個都是大眼睛。"}, {"sex": "M", "tone": "neutral", "text": "姊姊每天搶電視看小甜甜。我說那是女生看的，結果自己也看到安東尼摔馬那集。"}]},
  {"id": "mazinger", "cat": "卡通", "name": "無敵鐵金剛", "y": [1978, 1983], "minAge": 5, "maxAge": 13, "weight": 1.2, "src": "華視1978播出", "lines": [{"sex": "M", "tone": "good", "text": "下課時間我們在走廊比誰的「火箭飛拳」比較遠，我的拖鞋飛出去打到訓導主任的腳。"}, {"tone": "neutral", "text": "巷口雜貨店賣無敵鐵金剛的塑膠玩具，我每天經過都看一下，看了一個月它還在，我的零用錢也還不夠。"}]},
  {"id": "gatchaman", "cat": "卡通", "name": "科學小飛俠", "y": [1977, 1982], "minAge": 5, "maxAge": 13, "weight": 1, "src": "台灣1970年代末播出", "lines": [{"tone": "good", "text": "我們五個人分角色玩科學小飛俠。我被分到珍珍，因為我最矮。"}]},
  {"id": "doraemon_pirate", "cat": "卡通", "name": "小叮噹漫畫", "y": [1977, 1996], "minAge": 6, "maxAge": 15, "weight": 1.4, "src": "青文盜版漫畫1976年底起", "lines": [{"tone": "good", "text": "我在租書店蹲著看小叮噹，看到老闆咳嗽才趕快放回去。那本的封面已經被翻到快掉了。"}, {"tone": "neutral", "text": "我跟同學爭論大雄到底是不是叫葉大雄，吵到上課鐘響都沒有結論。"}]},
  {"id": "doraemon_rename", "cat": "卡通", "name": "哆啦A夢", "y": [1997, 2005], "minAge": 6, "maxAge": 40, "weight": 0.9, "src": "1997年前後正式授權改譯哆啦A夢（出版社說法不一）", "lines": [{"maxAge": 14, "tone": "neutral", "text": "新出的漫畫上面寫「哆啦A夢」，我拿去問老闆是不是印錯了。老闆說以後都叫這個了。"}, {"minAge": 20, "tone": "neutral", "text": "表弟說小叮噹現在叫哆啦A夢，胖虎叫技安以前就不對。我覺得我的童年被改名了。"}]},
  {"id": "variety100", "cat": "電視", "name": "綜藝100", "y": [1979, 1984], "minAge": 6, "maxAge": 60, "weight": 1, "src": "華視1979-08至1984-10，張小燕主持", "lines": [{"tone": "good", "text": "禮拜六晚上全家吃完飯就坐好等綜藝100。爸爸說張小燕講話太快，自己卻笑得最大聲。"}]},
  {"id": "chor_lau_heung", "cat": "電視", "name": "楚留香", "y": [1982, 1983], "minAge": 8, "maxAge": 70, "weight": 1.4, "src": "港劇，中視1982-04播出造成轟動", "lines": [{"maxAge": 14, "tone": "good", "text": "楚留香播出的時候，街上安靜到可以聽到隔壁的電視在唱「湖海洗我胸襟」。我在巷子裡揮著扇子學鄭少秋走路。"}, {"minAge": 18, "tone": "neutral", "text": "晚上八點我騎車回家，路上幾乎沒有人，連夜市攤販都在看楚留香。"}]},
  {"id": "stars_know", "cat": "電視", "name": "星星知我心", "y": [1983, 1983], "minAge": 8, "maxAge": 70, "weight": 1, "src": "台視1983-08", "lines": [{"maxAge": 15, "tone": "bad", "text": "看到古秋霞把小孩一個一個送人那集，我哭到隔天眼睛腫起來，被同學笑了一整天。"}, {"minAge": 20, "need": ["kids"], "tone": "neutral", "text": "看完星星知我心，我走進小孩房間，看他們睡覺看了很久。"}]},
  {"id": "campus_folk", "cat": "音樂", "name": "校園民歌", "y": [1975, 1983], "minAge": 14, "maxAge": 30, "weight": 1.2, "skew": {"urban": 1.2}, "src": "金韻獎1977開辦", "lines": [{"tone": "good", "text": "我存了兩個月的錢買了一把吉他，只學會〈橄欖樹〉的前奏，每天彈給自己聽。"}, {"tone": "neutral", "text": "班上有人帶吉他去郊遊，大家圍成一圈唱〈外婆的澎湖灣〉。我不太會唱，負責拍手。"}]},
  {"id": "lo_tayu", "cat": "音樂", "name": "羅大佑", "y": [1982, 1986], "minAge": 14, "maxAge": 30, "weight": 0.9, "src": "之乎者也1982", "lines": [{"tone": "neutral", "text": "同學借我一卷羅大佑的錄音帶，我拿鉛筆捲帶子捲了好幾次，聽到〈鹿港小鎮〉那句，覺得在罵我們這種從鄉下上來的人，又好像在幫我們講話。"}]},
  {"id": "jinyong", "cat": "流行", "name": "金庸小說", "y": [1980, 1999], "minAge": 12, "maxAge": 45, "weight": 1.1, "src": "遠景1980正式出版", "lines": [{"maxAge": 18, "tone": "good", "text": "我把金庸小說包上課本的書套，在數學課看完了《射鵰》第二冊。"}, {"minAge": 19, "tone": "neutral", "text": "宿舍熄燈後，我打著手電筒看《笑傲江湖》，看到天亮，早上點名差點沒到。"}]},
  {"id": "arcade", "cat": "遊戲", "name": "電動玩具店", "y": [1979, 1995], "minAge": 9, "maxAge": 22, "weight": 1.2, "src": "小蜜蜂、小精靈1979起；1982政府掃蕩電玩", "lines": [{"maxAge": 15, "tone": "bad", "text": "我躲在電動玩具店打小蜜蜂，教官從門口走進來。我從後門跑掉，書包忘在機台上。"}, {"tone": "neutral", "text": "我把早餐錢換成代幣，在快打旋風前面站了一整個下午。肚子很餓，但我終於破到第五關。"}]},
  {"id": "famicom", "cat": "遊戲", "name": "紅白機", "y": [1984, 1994], "minAge": 6, "maxAge": 18, "weight": 1.3, "skew": {"urban": 1.2}, "src": "日本1983；台灣電視遊樂器約1986普及，小天才1987–1994", "lines": [{"tone": "good", "text": "表哥家有紅白機，我去他家玩超級瑪利，一隻烏龜踩了一百次，賺了好多命。"}, {"tone": "neutral", "text": "卡帶插進去沒畫面，我拿出來對著接口吹氣，吹了三次就好了。我一直相信是口水的功勞。"}, {"tone": "bad", "text": "媽媽說一天只能玩三十分鐘，鬧鐘一響她就拔插頭，我還沒存檔。"}]},
  {"id": "rubik", "cat": "童玩", "name": "魔術方塊", "y": [1981, 1983], "minAge": 8, "maxAge": 25, "weight": 0.8, "src": "1980–82全球熱潮，台灣年份以此推估", "lines": [{"tone": "neutral", "text": "我轉了一個禮拜的魔術方塊，只轉好一面。最後我把貼紙撕下來重貼。"}]},
  {"id": "anglebiao", "cat": "童玩", "name": "尪仔標", "y": [1961, 1985], "minAge": 5, "maxAge": 12, "weight": 1, "skew": {"rural": 1.3}, "src": "1960–80年代童玩", "lines": [{"tone": "good", "text": "我用一張舊尪仔標贏了隔壁阿明一整疊，他哭著回家叫他哥哥來。我把尪仔標藏在床底下的餅乾盒裡。"}]},
  {"id": "pokepoke", "cat": "童玩", "name": "戳戳樂", "y": [1965, 1995], "minAge": 5, "maxAge": 12, "weight": 1, "src": "柑仔店抽獎紙", "lines": [{"tone": "bad", "text": "我在柑仔店戳了五格戳戳樂，全部都是「銘謝惠顧」。大獎那個塑膠機器人一直掛在最上面。"}]},
  {"id": "paper_doll", "cat": "童玩", "name": "紙娃娃", "y": [1968, 1992], "minAge": 5, "maxAge": 12, "weight": 0.9, "src": "柑仔店紙娃娃", "lines": [{"tone": "good", "text": "我用一塊錢買了一張紙娃娃，小心剪了整個下午。衣服的小耳朵剪斷了一個，我用膠帶黏回去。"}]},
  {"id": "guaiguai", "cat": "零食", "name": "乖乖", "y": [1968, 2110], "minAge": 4, "maxAge": 12, "weight": 1, "src": "1968上市", "lines": [{"tone": "good", "text": "乖乖裡面的玩具是一個塑膠小哨子。我吹了一整天，被爸爸沒收了。"}]},
  {"id": "prince_noodle", "cat": "零食", "name": "王子麵", "y": [1970, 2110], "minAge": 6, "maxAge": 16, "weight": 0.9, "src": "味王1970", "lines": [{"tone": "good", "text": "我把王子麵捏碎，把調味粉倒進去搖一搖，跟同學一人一口吃完。手指上的粉舔了一整節課。"}]},
  {"id": "science_noodle", "cat": "零食", "name": "科學麵", "y": [1978, 2110], "minAge": 6, "maxAge": 16, "weight": 0.9, "src": "統一1978", "lines": [{"tone": "neutral", "text": "為了集科學麵裡的卡，我一個禮拜吃了七包，卡還差兩張，牙齦破了一個洞。"}]},
  {"id": "yakult", "cat": "零食", "name": "養樂多", "y": [1964, 2000], "minAge": 3, "maxAge": 12, "weight": 0.8, "src": "台灣養樂多1964", "lines": [{"tone": "good", "text": "養樂多媽媽騎腳踏車來送貨，我每天在門口等。一瓶養樂多我用牙齒咬開底部，慢慢吸了十分鐘。"}]},
  {"id": "pudding", "cat": "零食", "name": "統一布丁", "y": [1990, 2110], "minAge": 4, "maxAge": 12, "weight": 0.7, "src": "上市年未查到，以1990年代起常見計", "lines": [{"tone": "good", "text": "我把布丁倒扣在盤子上，戳一下底下的小凸點，焦糖流下來。弟弟說他也要，我已經吃完了。"}]},
  {"id": "seven_eleven", "cat": "流行", "name": "7-ELEVEn", "y": [1980, 1990], "minAge": 8, "maxAge": 40, "weight": 0.8, "skew": {"urban": 1.6, "rural": 0.4}, "src": "台灣第一家長安門市1980-02", "lines": [{"tone": "neutral", "text": "家附近開了一家二十四小時都不關門的店。我半夜十一點進去買了一瓶汽水，覺得自己很像大人。"}]},
  {"id": "mcdonalds", "cat": "零食", "name": "麥當勞", "y": [1984, 1992], "minAge": 5, "maxAge": 40, "weight": 1, "skew": {"urban": 1.6, "rural": 0.4}, "src": "台灣第一家1984-01民生東路", "lines": [{"maxAge": 14, "tone": "good", "text": "考試考了一百分，爸爸帶我去吃麥當勞。我把漢堡的紙盒帶回家收在抽屜裡。"}, {"minAge": 18, "tone": "neutral", "text": "我第一次去麥當勞，排在後面一直偷看前面的人怎麼點。輪到我時還是說成了「一個那個」。"}]},
  {"id": "tapioca", "cat": "零食", "name": "珍珠奶茶", "y": [1988, 2110], "minAge": 12, "maxAge": 45, "weight": 0.9, "src": "約1987起源", "lines": [{"y": [1988, 1996], "tone": "good", "text": "學校旁邊開了一家泡沫紅茶店，有一種奶茶加了黑黑的粉圓。我第一次喝就被珍珠噎到。"}, {"y": [2010, 2110], "tone": "neutral", "text": "我點了一杯珍奶，半糖少冰，等的人排到騎樓外面。"}]},
  {"id": "wo_cai", "cat": "電視", "name": "我猜", "y": [1996, 2011], "minAge": 6, "maxAge": 50, "weight": 1, "src": "1996-07至2011", "lines": [{"maxAge": 15, "tone": "good", "text": "禮拜六晚上看我猜，我跟全家一起猜謎，猜錯的人要去洗碗。我洗了三天。"}, {"minAge": 16, "tone": "neutral", "text": "週末晚上電視開著我猜，我其實在滑別的東西，但聽到笑聲還是會抬頭看一下。"}]},
  {"id": "little_tigers", "cat": "音樂", "name": "小虎隊", "y": [1988, 1992], "minAge": 9, "maxAge": 20, "weight": 1.1, "src": "1988出道", "lines": [{"sex": "F", "tone": "good", "text": "我的鉛筆盒裡貼著小虎隊的貼紙，乖乖虎那張貼在最中間。"}, {"tone": "neutral", "text": "班會表演，我們五個人跳〈青蘋果樂園〉，有一個人一直跳錯邊，全班笑到老師也在笑。"}]},
  {"id": "mtv_room", "cat": "流行", "name": "MTV包廂", "y": [1983, 1995], "minAge": 16, "maxAge": 30, "weight": 0.8, "skew": {"urban": 1.5, "rural": 0.5}, "src": "第一家MTV包廂1984，1980年代末最盛", "lines": [{"tone": "neutral", "text": "我們去MTV包廂看錄影帶，老闆給的片單一半是盜版。我們挑了一部港片，看到一半睡著了。"}]},
  {"id": "video_store", "cat": "流行", "name": "錄影帶店", "y": [1983, 2008], "minAge": 12, "maxAge": 50, "weight": 0.9, "src": "錄影帶出租1980年代起；百視達1997來台，DVD後式微", "lines": [{"tone": "bad", "text": "租來的錄影帶忘了倒帶就還回去，老闆罰了我十塊。"}, {"y": [1983, 1995], "tone": "neutral", "text": "週末爸爸租了豬哥亮的歌廳秀錄影帶，全家擠在客廳笑。有幾段他快轉，說小孩不能看。"}]},
  {"id": "ktv", "cat": "流行", "name": "KTV", "y": [1991, 2110], "minAge": 16, "maxAge": 55, "weight": 0.9, "skew": {"urban": 1.3, "原住民": 1.4}, "src": "KTV1990年代普及（錢櫃成立年份說法不一）", "lines": [{"tone": "good", "text": "同事聚餐續攤去KTV，主管點了一首〈愛拚才會贏〉，大家站起來拍手。我點的歌一直被插播。"}, {"maxAge": 25, "tone": "good", "text": "我們包了通宵KTV，唱到早上六點出來，外面的天亮得很刺眼，大家的聲音都啞了。"}]},
  {"id": "karaoke_tribe", "cat": "音樂", "name": "部落卡拉OK", "y": [1985, 2110], "minAge": 12, "maxAge": 70, "eth": "原住民", "weight": 1.2, "src": "部落卡拉OK文化", "lines": [{"tone": "good", "text": "晚上部落的卡拉OK又開了，叔叔一首接一首唱，表哥拿吉他在旁邊合音。我坐在塑膠椅上聽，蚊子很多，但沒人想走。"}]},
  {"id": "bbcall", "cat": "科技", "name": "BB Call", "y": [1990, 1999], "minAge": 15, "maxAge": 45, "weight": 1.1, "src": "呼叫器1990年代中普及", "lines": [{"maxAge": 25, "tone": "good", "text": "呼叫器上出現「520」，我在公用電話前排了五分鐘回電，接起來的是對方的媽媽。"}, {"minAge": 26, "need": ["working"], "tone": "neutral", "text": "老闆一直call我，我找不到公共電話，騎車騎了三條街，回電的時候他已經去吃飯了。"}]},
  {"id": "dageda", "cat": "科技", "name": "大哥大", "y": [1989, 1996], "minAge": 25, "maxAge": 60, "weight": 0.7, "skew": {"urban": 1.4}, "src": "1989開放行動電話", "lines": [{"tone": "neutral", "text": "老闆在餐廳拿出大哥大講電話，整間的人都轉頭看他。那支電話像一塊磚頭，他講得很大聲。"}]},
  {"id": "bao_qingtian", "cat": "電視", "name": "包青天", "y": [1993, 1994], "minAge": 6, "maxAge": 80, "weight": 1.1, "src": "華視1993", "lines": [{"maxAge": 14, "tone": "good", "text": "我用黑色簽字筆在額頭畫月亮，拿掃把當狗頭鍘，追著妹妹說「開鍘」。"}, {"minAge": 30, "tone": "neutral", "text": "晚上看包青天，{elders}說現在的官要是像包大人就好了，然後換台去看新聞。"}]},
  {"id": "slam_dunk", "cat": "卡通", "name": "灌籃高手", "y": [1993, 2000], "minAge": 9, "maxAge": 22, "weight": 1.2, "src": "漫畫1990年代初；台灣動畫約1995（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"sex": "M", "tone": "good", "text": "看完灌籃高手，全班男生都跑去打籃球。我投了一百顆，進了三顆，還是說自己是天才。"}, {"sex": "F", "tone": "good", "text": "我在課本空白的地方畫流川楓，畫了一整排，被數學老師看到，他只說「畫得不錯」。"}]},
  {"id": "maruko", "cat": "卡通", "name": "櫻桃小丸子", "y": [1991, 2005], "minAge": 5, "maxAge": 14, "weight": 0.9, "src": "台灣1990年代初播出（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "neutral", "text": "看櫻桃小丸子的時候，我覺得我家的爺爺奶奶一點都不像她的爺爺。我家阿公只會叫我去寫功課。"}]},
  {"id": "crayon_shin", "cat": "卡通", "name": "蠟筆小新", "y": [1993, 2010], "minAge": 6, "maxAge": 15, "weight": 1, "src": "台灣1990年代播出", "lines": [{"tone": "bad", "text": "我在家裡學蠟筆小新跳大象舞，被媽媽看到，從此不准我看這部卡通。"}]},
  {"id": "sailor_moon", "cat": "卡通", "name": "美少女戰士", "y": [1994, 1999], "minAge": 5, "maxAge": 13, "weight": 1, "src": "台灣1990年代中播出", "lines": [{"sex": "F", "tone": "good", "text": "我拿媽媽的口紅蓋當變身器，對著鏡子喊「代替月亮懲罰你」，喊到被哥哥錄音。"}, {"sex": "M", "tone": "neutral", "text": "妹妹逼我演夜禮服假面，我拿了一朵塑膠玫瑰丟出去，丟到她頭上。"}]},
  {"id": "conan", "cat": "卡通", "name": "名偵探柯南", "y": [1997, 2015], "minAge": 8, "maxAge": 18, "weight": 0.9, "src": "台灣1997起播出（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "neutral", "text": "班上掉了一枝自動鉛筆，我推了眼鏡說「真相只有一個」，結果是我自己放在鉛筆盒夾層。"}]},
  {"id": "mini4wd", "cat": "童玩", "name": "四驅車", "y": [1996, 1999], "minAge": 7, "maxAge": 15, "weight": 1.1, "skew": {"urban": 1.2}, "src": "爆走兄弟熱潮", "lines": [{"tone": "good", "text": "我把四驅車的馬達換成黑色那顆，在文具店的跑道上一出去就飛出場外，撞到老闆的腳。"}, {"tone": "bad", "text": "我把整個月的零用錢都拿去買四驅車的零件，車子跑得更快了，我中午只能吃白吐司。"}]},
  {"id": "tamagotchi", "cat": "童玩", "name": "電子雞", "y": [1997, 1998], "minAge": 7, "maxAge": 18, "weight": 1, "src": "1997熱潮（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "bad", "text": "上課時間不能拿出電子雞，我的雞在抽屜裡餓死了。下課我幫牠按了重來，心情很差。"}]},
  {"id": "stickers_photo", "cat": "流行", "name": "大頭貼", "y": [1997, 2008], "minAge": 12, "maxAge": 25, "weight": 0.9, "skew": {"urban": 1.3}, "src": "拍貼機約1997起（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "good", "text": "放學我跟同學擠進拍貼機，拍了十六格，每一格都在比YA。我們把貼紙一張一張剪開分。"}]},
  {"id": "a_mei", "cat": "音樂", "name": "張惠妹", "y": [1996, 2005], "minAge": 10, "maxAge": 50, "weight": 1, "skew": {"原住民": 1.6}, "src": "姊妹1996", "lines": [{"tone": "good", "text": "電視在播阿妹的〈姊妹〉，我跟著扭了兩下，發現家人都在看我。"}, {"eth": "原住民", "tone": "good", "text": "部落裡的阿姨說阿妹是卑南族的，講的時候很驕傲，好像在講自己家的孩子。"}]},
  {"id": "huanzhu", "cat": "電視", "name": "還珠格格", "y": [1998, 2000], "minAge": 7, "maxAge": 70, "weight": 1.1, "src": "中視1998", "lines": [{"maxAge": 15, "tone": "good", "text": "下課的時候，女生在學小燕子翻白眼，男生在學爾康說「紫薇！」，整個走廊都在吵。"}, {"minAge": 30, "tone": "neutral", "text": "晚上吃完飯全家看還珠格格，連平常不看電視的{elders}也坐在旁邊，說皇帝太寵女兒了。"}]},
  {"id": "egg_tart", "cat": "零食", "name": "葡式蛋塔", "y": [1998, 1998], "minAge": 10, "maxAge": 60, "weight": 0.9, "src": "1998熱潮後退燒", "lines": [{"tone": "neutral", "text": "巷口開了第三家蛋塔店，我排了一個小時才買到六個。第一口很好吃，第六個吃不下了。"}, {"minAge": 25, "tone": "bad", "text": "表哥頂了店面開蛋塔店，三個月後收起來了。他說只差一點點，大家就不吃了。"}]},
  {"id": "internet_cafe", "cat": "遊戲", "name": "網咖", "y": [1998, 2006], "minAge": 12, "maxAge": 28, "weight": 1.1, "src": "網咖1990年代末至2000年代中", "lines": [{"tone": "neutral", "text": "我在網咖包了通宵，桌上一碗泡麵，耳機裡的人一直罵我補血太慢。天亮走出來的時候，我身上都是菸味。"}]},
  {"id": "lineage", "cat": "遊戲", "name": "天堂", "y": [2000, 2006], "minAge": 13, "maxAge": 35, "weight": 1, "src": "遊戲橘子2000代理", "lines": [{"tone": "bad", "text": "我在天堂打了三個月才拿到的裝備被盜了。我請了一天假去報案，警察聽了半天問我「所以那是真的劍嗎」。"}, {"tone": "good", "text": "我們血盟打攻城戰，從晚上十點打到凌晨兩點，贏了。隔天上課我一直在笑。"}]},
  {"id": "pal", "cat": "遊戲", "name": "仙劍奇俠傳", "y": [1995, 2000], "minAge": 11, "maxAge": 28, "weight": 0.9, "src": "大宇1995", "lines": [{"tone": "bad", "text": "仙劍玩到林月如那段，我在電腦前面坐了很久，關掉螢幕還是想著。"}]},
  {"id": "richman", "cat": "遊戲", "name": "大富翁", "y": [1990, 2005], "minAge": 8, "maxAge": 30, "weight": 0.7, "src": "大宇1989第一代", "lines": [{"tone": "good", "text": "我跟哥哥玩電腦大富翁，我抽到「孫小美」，被他的土地公一直收過路費。"}]},
  {"id": "jay", "cat": "音樂", "name": "周杰倫", "y": [2000, 2012], "minAge": 10, "maxAge": 30, "weight": 1.3, "src": "首張專輯Jay 2000-11", "lines": [{"maxAge": 20, "tone": "good", "text": "我把周杰倫的歌詞抄在筆記本上，抄了三頁還是聽不清楚他唱什麼，最後去買了歌詞本。"}, {"minAge": 21, "tone": "neutral", "text": "大人說周杰倫講話含滷蛋。我沒反駁，但我的手機鈴聲是〈雙截棍〉。"}]},
  {"id": "mayday", "cat": "音樂", "name": "五月天", "y": [1999, 2110], "minAge": 13, "maxAge": 40, "weight": 1, "src": "1999首張專輯", "lines": [{"tone": "good", "text": "我搶到五月天的演唱會票，在體育場跳到小腿抽筋，回家的路上喉嚨一句話都講不出來。"}]},
  {"id": "meteor_garden", "cat": "電視", "name": "流星花園", "y": [2001, 2002], "minAge": 10, "maxAge": 40, "weight": 1.2, "src": "華視2001-04", "lines": [{"sex": "F", "tone": "good", "text": "我把F4的海報貼在衣櫃門內側，每天換衣服都看得到。"}, {"sex": "M", "tone": "neutral", "text": "女生都在講道明寺，我把頭髮弄捲，被班導問我是不是燙到了。"}]},
  {"id": "she", "cat": "音樂", "name": "S.H.E", "y": [2001, 2010], "minAge": 10, "maxAge": 25, "weight": 0.8, "src": "2001出道", "lines": [{"tone": "good", "text": "畢業典禮那天全班合唱〈Super Star〉，我唱到一半被同學拉起來跳。"}]},
  {"id": "jolin", "cat": "音樂", "name": "蔡依林", "y": [2003, 2010], "minAge": 10, "maxAge": 30, "weight": 0.8, "src": "看我72變2003", "lines": [{"sex": "F", "tone": "neutral", "text": "我在房間學蔡依林跳舞，對著衣櫃的鏡子一直練那個下腰，結果閃到腰。"}]},
  {"id": "pikachu", "cat": "卡通", "name": "神奇寶貝", "y": [1998, 2010], "minAge": 5, "maxAge": 15, "weight": 1.1, "src": "中視1998-11首播", "lines": [{"tone": "good", "text": "我們在下課時間比誰收集的神奇寶貝卡多，我那張閃亮的噴火龍放在書包最裡面。"}]},
  {"id": "beyblade", "cat": "童玩", "name": "戰鬥陀螺", "y": [2001, 2003], "minAge": 6, "maxAge": 13, "weight": 1, "src": "2000年代初熱潮", "lines": [{"tone": "good", "text": "我們在走廊用臉盆當戰鬥盤，我的陀螺把同學的打飛出去，飛進了男廁。"}]},
  {"id": "yugioh", "cat": "童玩", "name": "遊戲王卡", "y": [2000, 2008], "minAge": 8, "maxAge": 18, "weight": 0.9, "src": "2000年代初熱潮（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "neutral", "text": "我用三張普通卡換到一張青眼白龍，後來才知道那張是盜版的，摸起來特別薄。"}]},
  {"id": "naruto", "cat": "卡通", "name": "火影忍者", "y": [2003, 2014], "minAge": 8, "maxAge": 22, "weight": 1.1, "src": "日本2002動畫，台灣2000年代中（台灣確切年份未查到，依日本推出時間推估）", "lines": [{"tone": "good", "text": "下課我跟同學雙手往後伸，學鳴人跑步跑過操場，被體育老師叫回來罰站。"}]},
  {"id": "msn", "cat": "科技", "name": "MSN", "y": [2000, 2012], "minAge": 12, "maxAge": 40, "weight": 1.2, "src": "約2000–2013", "lines": [{"maxAge": 25, "tone": "neutral", "text": "我把MSN的暱稱改成一句歌詞，等某個人上線來問我怎麼了。他上線了，沒有問。"}, {"minAge": 26, "need": ["working"], "tone": "neutral", "text": "上班時間MSN一直跳出視窗，我趕快按最小化，結果按到「傳送檔案」給主管。"}]},
  {"id": "wretch", "cat": "科技", "name": "無名小站", "y": [2003, 2013], "minAge": 13, "maxAge": 30, "weight": 1.1, "src": "2003起流行，2013-12關站", "lines": [{"tone": "good", "text": "我在無名小站放了一張四十五度角的自拍，訪客計數器一天跳了兩百，我截圖存起來。"}, {"y": [2013, 2013], "tone": "bad", "text": "無名小站要關了，我回去看以前的網誌，看到一半把網頁關掉，覺得太丟臉。"}]},
  {"id": "ptt", "cat": "科技", "name": "PTT", "y": [1998, 2110], "minAge": 17, "maxAge": 45, "weight": 0.8, "skew": {"urban": 1.2}, "src": "1995成立", "lines": [{"tone": "neutral", "text": "我半夜在PTT推了一篇文，隔天醒來被噓到變成「XX」，我把帳號登出一整個禮拜。"}]},
  {"id": "hello_kitty_magnet", "cat": "流行", "name": "Kitty磁鐵", "y": [2005, 2005], "minAge": 8, "maxAge": 60, "weight": 0.9, "src": "7-ELEVEn 2005集點", "lines": [{"maxAge": 15, "tone": "good", "text": "媽媽買東西都去7-ELEVEn，就為了集Hello Kitty磁鐵。冰箱門貼滿了，我們家冰箱看起來很熱鬧。"}, {"minAge": 20, "tone": "neutral", "text": "我在便利商店結帳的時候，後面的大姐問我點數要不要，我給她了，她跟我說了三次謝謝。"}]},
  {"id": "mister_donut", "cat": "零食", "name": "甜甜圈排隊", "y": [2004, 2005], "minAge": 12, "maxAge": 50, "weight": 0.7, "skew": {"urban": 1.6, "rural": 0.4}, "src": "2004開幕排隊潮", "lines": [{"tone": "neutral", "text": "我排了兩個小時買甜甜圈，排到的時候只剩下最普通的那種。我還是拍了照。"}]},
  {"id": "maplestory", "cat": "遊戲", "name": "楓之谷", "y": [2005, 2010], "minAge": 9, "maxAge": 22, "weight": 0.9, "src": "台灣2005", "lines": [{"tone": "good", "text": "我在楓之谷蹲在一個地方練了一整個暑假，等級到了七十，媽媽以為我在寫暑假作業。"}]},
  {"id": "kartrider", "cat": "遊戲", "name": "跑跑卡丁車", "y": [2006, 2009], "minAge": 9, "maxAge": 25, "weight": 0.7, "src": "台灣2006", "lines": [{"tone": "neutral", "text": "電腦課老師一轉頭，全班都切到跑跑卡丁車，鍵盤的方向鍵被我們敲到快掉了。"}]},
  {"id": "kang_xi", "cat": "電視", "name": "康熙來了", "y": [2004, 2016], "minAge": 12, "maxAge": 50, "weight": 1, "src": "中天2004–2016", "lines": [{"tone": "good", "text": "我一邊吃宵夜一邊看康熙來了，笑到泡麵的湯噴到電視螢幕上。"}, {"y": [2016, 2016], "tone": "neutral", "text": "康熙來了最後一集，我本來沒有在看了，那天還是打開電視，看完才去洗澡。"}]},
  {"id": "thunder_fire", "cat": "電視", "name": "台灣霹靂火", "y": [2002, 2003], "minAge": 10, "maxAge": 80, "weight": 0.9, "skew": {"閩南": 1.4}, "src": "三立2002-06至2003-07", "lines": [{"tone": "good", "text": "全家在看台灣霹靂火，劉文聰一開口，我跟著喊「送你一桶汽油，一枝番仔火」，媽媽叫我小聲一點。"}]},
  {"id": "iphone", "cat": "科技", "name": "iPhone", "y": [2009, 2012], "minAge": 16, "maxAge": 50, "weight": 0.8, "skew": {"urban": 1.3}, "src": "iPhone 3G台灣2008-12上市", "lines": [{"tone": "neutral", "text": "同事拿出新手機，用手指一劃就換頁。大家圍過去看，我的手機按鍵上的字已經磨掉一半了。"}]},
  {"id": "farmville", "cat": "遊戲", "name": "開心農場", "y": [2009, 2010], "minAge": 15, "maxAge": 60, "weight": 1, "src": "Facebook 2009熱潮", "lines": [{"minAge": 25, "need": ["working"], "tone": "neutral", "text": "我設了半夜三點的鬧鐘起來收菜。隔天開會，坐我旁邊的同事也在打哈欠，他說他去偷了我的菜。"}, {"maxAge": 24, "tone": "good", "text": "我在開心農場偷了我媽的菜，她打電話來罵我，我第一次覺得她會用電腦很厲害。"}]},
  {"id": "plurk", "cat": "科技", "name": "噗浪", "y": [2008, 2011], "minAge": 16, "maxAge": 35, "weight": 0.6, "src": "2008起流行", "lines": [{"tone": "neutral", "text": "我在噗浪寫了一句「好累」，二十個人回應，我都不認識。"}]},
  {"id": "cape7", "cat": "電影", "name": "海角七號", "y": [2008, 2009], "minAge": 12, "maxAge": 80, "weight": 0.9, "src": "2008-08上映", "lines": [{"tone": "good", "text": "我陪家人去看海角七號，戲院坐滿了。茂伯彈月琴那段，後面的阿伯笑得最大聲。"}]},
  {"id": "line_app", "cat": "科技", "name": "LINE", "y": [2012, 2110], "minAge": 12, "maxAge": 90, "weight": 1, "src": "台灣2011上線，2012普及", "lines": [{"minAge": 40, "tone": "neutral", "text": "我學會用LINE傳貼圖，每天早上傳一張「早安」給所有人。小孩說不用每天傳，我還是傳。"}, {"maxAge": 39, "tone": "bad", "text": "家族群組又有人傳「喝這個可以防癌」，我想反駁，打了一大段又刪掉，只按了個讚。"}]},
  {"id": "those_years", "cat": "電影", "name": "那些年", "y": [2011, 2012], "minAge": 15, "maxAge": 40, "weight": 0.8, "src": "2011上映", "lines": [{"tone": "neutral", "text": "看完那些年，我在回家的公車上，想了一下高中坐我前面的那個人，然後滑手機滑過去了。"}]},
  {"id": "angry_birds", "cat": "遊戲", "name": "手機小遊戲", "y": [2010, 2014], "minAge": 8, "maxAge": 70, "weight": 0.8, "src": "憤怒鳥2009-12推出；Candy Crush 2013台灣約三百萬人玩", "lines": [{"minAge": 40, "tone": "neutral", "text": "我在捷運上玩Candy Crush，卡在同一關一個禮拜。我把手機借給小孩，他三分鐘就過了。"}, {"maxAge": 39, "tone": "good", "text": "我用手機玩憤怒鳥，一隻鳥射出去，全部的豬一起倒，我在公車上叫了一聲。"}]},
  {"id": "tos", "cat": "遊戲", "name": "神魔之塔", "y": [2013, 2016], "minAge": 10, "maxAge": 35, "weight": 0.8, "src": "2013-01推出", "lines": [{"tone": "neutral", "text": "我在神魔之塔抽了五次，全部都是重複的卡。我發誓再也不課金，下個月又抽了一次。"}]},
  {"id": "instagram", "cat": "科技", "name": "Instagram", "y": [2014, 2110], "minAge": 13, "maxAge": 45, "weight": 0.9, "src": "台灣約2014起普及，限時動態2016", "lines": [{"tone": "neutral", "text": "菜上來了，大家先拿出手機拍，沒人敢先動筷子。我拍了五張，最後一張都沒發。"}]},
  {"id": "pokemon_go", "cat": "遊戲", "name": "寶可夢GO", "y": [2016, 2017], "minAge": 8, "maxAge": 75, "weight": 1, "src": "台灣2016-08-06上線", "lines": [{"maxAge": 40, "tone": "good", "text": "聽說北投公園有快龍，我騎車去，整條路都是低頭的人。我沒抓到，但我抓到了路邊的阿伯一起討論。"}, {"minAge": 41, "tone": "neutral", "text": "我在公園散步，看到一群人突然一起往同一個方向跑。我也跟著跑了一段，才知道他們在抓寶。"}]},
  {"id": "claw_machine", "cat": "流行", "name": "夾娃娃機店", "y": [2017, 2019], "minAge": 10, "maxAge": 45, "weight": 0.8, "src": "2017–2018夾娃娃機店暴增", "lines": [{"tone": "bad", "text": "巷口的店面又變成夾娃娃機店了。我投了兩百塊，夾到一個不知道是什麼角色的娃娃。"}]},
  {"id": "tiktok", "cat": "科技", "name": "短影音", "y": [2018, 2110], "minAge": 10, "maxAge": 70, "weight": 0.9, "src": "抖音／TikTok約2018起", "lines": [{"maxAge": 35, "tone": "neutral", "text": "我說只滑一下短影音就睡，抬頭已經兩點了，手機燙得像暖暖包。"}, {"minAge": 36, "tone": "neutral", "text": "我在客廳聽到小孩一直在學一段舞，問他是什麼，他說「你不會懂」，說完又跳了一次。"}]},
  {"id": "demon_slayer", "cat": "卡通", "name": "鬼滅之刃", "y": [2020, 2021], "minAge": 8, "maxAge": 40, "weight": 0.9, "src": "無限列車2020-10上映", "lines": [{"tone": "good", "text": "我跟同學去看鬼滅之刃電影，散場的時候，有一半的人眼睛是紅的。外面有小孩穿著綠黑格子的外套。"}]},
  {"id": "animal_crossing", "cat": "遊戲", "name": "動物森友會", "y": [2020, 2021], "minAge": 10, "maxAge": 45, "weight": 0.7, "src": "2020-03發售，Switch缺貨", "lines": [{"tone": "neutral", "text": "大家都在家裡，我在動物森友會的小島上種花，跟住在別的城市的朋友在島上見面。那是我那個月最常出門的地方。"}]},
  {"id": "squid_game", "cat": "電視", "name": "魷魚遊戲", "y": [2021, 2021], "minAge": 12, "maxAge": 60, "weight": 0.7, "src": "2021-09", "lines": [{"tone": "neutral", "text": "同事在茶水間玩起椪糖，用針一點一點挑，挑壞了還大叫一聲。我在旁邊幫忙按住盤子。"}]},
  {"id": "chatbot", "cat": "科技", "name": "AI聊天", "y": [2023, 2110], "minAge": 12, "maxAge": 90, "weight": 0.8, "src": "ChatGPT 2022-11推出", "lines": [{"maxAge": 25, "tone": "neutral", "text": "我叫AI幫我寫報告，它寫得太好，我又請它幫我改得爛一點。"}, {"minAge": 60, "tone": "good", "text": "孫子幫我在手機裝了一個會回話的程式。我問它今天會不會下雨，它答得很客氣，我也跟它說謝謝。"}]},
  {"id": "threads_app", "cat": "科技", "name": "Threads", "y": [2023, 2110], "minAge": 15, "maxAge": 50, "weight": 0.6, "src": "2023-07推出", "lines": [{"tone": "neutral", "text": "我在Threads上看到一篇在問「你是幾年級的」，底下吵了兩千則。我也留了一則，然後一直回去看有沒有人按讚。"}]},
  {"id": "next_thing", "cat": "科技", "name": "新的App", "y": [2026, 2110], "minAge": 45, "maxAge": 95, "weight": 0.6, "src": "泛用：未來年份", "lines": [{"tone": "neutral", "text": "孫子在玩一個我看不懂的東西，我問他那是什麼，他解釋了三次，最後說「你不用懂啦」。我想起我小時候也這樣跟{elders}說過。"}]},
  {"id": "old_song_return", "cat": "音樂", "name": "老歌", "y": [2026, 2110], "minAge": 50, "maxAge": 95, "weight": 0.6, "src": "泛用：未來年份", "lines": [{"tone": "good", "text": "賣場在放一首我年輕時候的歌，被改成很快的節奏。年輕店員跟著哼，我想跟他說原本不是這樣唱的，最後沒說。"}]},
  {"id": "hakka_tv", "cat": "電視", "name": "客家電視台", "y": [2003, 2110], "minAge": 30, "maxAge": 90, "eth": "客家", "weight": 0.8, "src": "2003開播", "lines": [{"tone": "good", "text": "{elders}發現電視上有一台整天講客家話，從此遙控器就沒有再離開那一台。"}]},
  {"id": "titv", "cat": "電視", "name": "原住民族電視台", "y": [2005, 2110], "minAge": 20, "maxAge": 90, "eth": "原住民", "weight": 0.8, "src": "2005開播", "lines": [{"tone": "good", "text": "原住民電視台的新聞拍到我們部落的豐年祭，阿姨打電話叫全家開電視，我們在畫面裡找到了舅舅的背影。"}]},
  {"id": "military_village_tv", "cat": "電視", "name": "國劇", "y": [1962, 1990], "minAge": 5, "maxAge": 15, "eth": "外省", "weight": 0.7, "src": "國劇電視節目1960–80年代", "lines": [{"tone": "neutral", "text": "禮拜天爺爺守著電視看國劇，鑼鼓一響我就想逃。他說等我長大就聽得懂，我現在還是聽不懂。"}]},
  {"id": "taigi_drama", "cat": "電視", "name": "台語八點檔", "y": [1997, 2015], "minAge": 10, "maxAge": 85, "weight": 0.9, "skew": {"閩南": 1.4, "rural": 1.2}, "src": "意難忘1997起，民視台語八點檔", "lines": [{"maxAge": 20, "tone": "neutral", "text": "晚上八點遙控器是{elders}的。八點檔演到婆婆打媳婦巴掌，{elders}罵得比劇裡的人還大聲。"}, {"minAge": 40, "tone": "neutral", "text": "我說只是看一下，結果連續看了兩個小時的八點檔，劇情跟十年前好像差不多。"}]},
  {"id": "ice_cart", "cat": "零食", "name": "叭噗", "y": [1961, 1985], "minAge": 4, "maxAge": 12, "weight": 1, "skew": {"rural": 1.2}, "src": "1960–80年代推車冰", "lines": [{"tone": "good", "text": "巷口傳來「叭噗、叭噗」的喇叭聲，我抓著一毛錢衝出去，冰淇淋已經在融了，我舔得滿手都是。"}]},
  {"id": "rubber_band", "cat": "童玩", "name": "跳橡皮筋", "y": [1961, 1995], "minAge": 6, "maxAge": 12, "weight": 0.9, "src": "1960–90年代校園遊戲", "lines": [{"tone": "good", "text": "下課我們把橡皮筋一條一條串起來，從腳踝跳到頭頂。輪到我拉的時候，我故意抬高一點，被罵賴皮。"}]},
  {"id": "radio_drama", "cat": "音樂", "name": "廣播劇", "y": [1961, 1975], "minAge": 6, "maxAge": 70, "weight": 0.8, "skew": {"rural": 1.3}, "src": "電視普及前的收音機節目", "lines": [{"maxAge": 15, "tone": "neutral", "text": "晚上全家圍著收音機聽廣播劇，講到鬼出來的地方，我把棉被拉到頭上，耳朵還是露在外面。"}, {"minAge": 25, "tone": "neutral", "text": "我一邊做手工一邊聽收音機講古，講到最精彩的地方說「欲知後事如何，明天再講」，我嘆了一口氣。"}]},
  {"id": "zhuge_silang", "cat": "卡通", "name": "諸葛四郎", "y": [1961, 1966], "minAge": 6, "maxAge": 15, "weight": 0.8, "src": "葉宏甲漫畫1958起連載", "lines": [{"tone": "good", "text": "我跟同學輪流看一本諸葛四郎，他看左頁我看右頁，翻頁要等兩個人都說好。"}]},
  {"id": "frozen", "cat": "電影", "name": "冰雪奇緣", "y": [2014, 2016], "minAge": 4, "maxAge": 40, "weight": 0.8, "src": "台灣2014-01上映", "lines": [{"maxAge": 12, "tone": "good", "text": "我穿著藍色的公主裙在客廳唱〈放開手〉，唱到最高音的時候撞到茶几。"}, {"minAge": 25, "need": ["kids"], "tone": "neutral", "text": "小孩在車上連續放了十次〈Let It Go〉，我開到一半已經會唱了。"}]},
  {"id": "youtuber", "cat": "科技", "name": "YouTuber", "y": [2015, 2110], "minAge": 7, "maxAge": 25, "weight": 0.9, "src": "台灣YouTuber約2015起成為孩子的志願", "lines": [{"tone": "neutral", "text": "作文題目是「我的志願」，我寫要當YouTuber。老師在旁邊批了一句「要先學會寫字」。"}]},
  {"id": "aov", "cat": "遊戲", "name": "傳說對決", "y": [2017, 2022], "minAge": 9, "maxAge": 25, "weight": 0.8, "src": "台灣2017推出", "lines": [{"tone": "bad", "text": "我在傳說對決排位連輸五場，隊友打字罵我，我把手機蓋在床上，五分鐘後又拿起來開了一場。"}]},
  {"id": "fidget", "cat": "童玩", "name": "指尖陀螺", "y": [2017, 2017], "minAge": 7, "maxAge": 18, "weight": 0.7, "src": "2017全球熱潮", "lines": [{"tone": "neutral", "text": "全班都在轉指尖陀螺，老師沒收了一整個鉛筆盒那麼多，放在講桌上轉給我們看。"}]},
  {"id": "slime", "cat": "童玩", "name": "史萊姆", "y": [2017, 2019], "minAge": 6, "maxAge": 14, "weight": 0.7, "src": "2017–2018熱潮", "lines": [{"tone": "bad", "text": "我在書桌上做史萊姆，膠水加太多，整坨黏在地毯上，媽媽拿吹風機吹了一個晚上。"}]},
  {"id": "genshin", "cat": "遊戲", "name": "原神", "y": [2020, 2025], "minAge": 10, "maxAge": 30, "weight": 0.7, "src": "2020-09推出", "lines": [{"tone": "neutral", "text": "我把壓歲錢拿去抽卡，抽到了想要的角色。我跟同學炫耀了一整天，晚上才想起那筆錢原本要買鞋子。"}]}
 ]
